15:["$","figcaption",null,{"data-count":"","children":[["$","strong",null,{"children":"Figure 3."}]," ",["China’s corn production and imports, 2015 to 2025, in million tonnes. Imports are by trade year starting in October, and 2025 imports are a USDA forecast (dashed). Data: ",["$","span","1",{"className":"cite","children":["",[["$","span","owid",{"children":["",["$","$L2",null,{"href":"/references/#owid","children":"Our World in Data (2026)"}]]}]],""]}],", ",["$","span","3",{"className":"cite","children":["",[["$","span","nbs",{"children":["",["$","$L2",null,{"href":"/references/#nbs","children":"NBS (2025)"}]]}]],""]}],", ",["$","span","5",{"className":"cite","children":["",[["$","span","imports",{"children":["",["$","$L2",null,{"href":"/references/#imports","children":"IndexMundi (n.d.)"}]]}]],""]}]," and ",["$","span","7",{"className":"cite","children":["",[["$","span","usda26b",{"children":["",["$","$L2",null,{"href":"/references/#usda26b","children":"USDA FAS (2026b)"}]]}]],""]}],"."]]}]
