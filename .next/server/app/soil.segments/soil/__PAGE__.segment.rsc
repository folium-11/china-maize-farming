","strokeWidth":"2.2","strokeLinecap":"round"}]],["$","path",null,{"d":"M300,165.96 L362,171.044","stroke":"#2a78d6","strokeWidth":"3","markerEnd":"url(#n-arrow-blue)","fill":"none"}],["$","path",null,{"d":"M214,139.90800000000002 L318,148.436","stroke":"#6b6256","strokeWidth":"3","markerEnd":"url(#n-arrow-grey)","fill":"none"}],[["$","circle","236",{"cx":236,"cy":153.712,"r":"2.6","fill":"#7a5634"}],["$","circle","258",{"cx":258,"cy":160.516,"r":"2.6","fill":"#7a5634"}],["$","circle","280",{"cx":280,"cy":157.32,"r":"2.6","fill":"#7a5634"}],["$","circle","302",{"cx":302,"cy":164.124,"r":"2.6","fill":"#7a5634"}]],["$","path",null,{"d":"M160,175.48 C152,153.48 170,139.48 162,121.47999999999999","stroke":"#6b6256","strokeWidth":"2.5","markerEnd":"url(#n-arrow-grey)","fill":"none"}],"$L44","$L45",["$L46","$L47"],"$L48","$L49","$L4a","$L4b"],"$L4c","$L4d","$L4e",["$L4f","$L50","$L51","$L52"]]}],"$L53"]}]
21:["$","figcaption",null,{"data-count":"","children":[["$","strong",null,{"children":"Figure 2."}]," ",["My cross-section of a sloping black soil field, farmed conventionally on the left and with straw cover and no till on the right. Not to scale. Figures from ",["$","span","1",{"className":"cite","children":["",[["$","span","liao",{"children":["",["$","$L2",null,{"href":"/references/#liao","children":"Liao et al. (2026)"}]]}]],""]}],", ",["$","span","3",{"className":"cite","children":["",[["$","span","jiang",{"children":["",["$","$L2",null,{"href":"/references/#jiang","children":"Jiang et al. (2025)"}]]}]],""]}]," and ",["$","span","5",{"className":"cite","children":["",[["$","span","sui",{"children":["",["$","$L2",null,{"href":"/references/#sui","children":"Sui and Dai (2025)"}]]}]],""]}],"."]]}]
22:["$","h2","3",{"data-count":"","children":"Three processes"}]
23:["$","p","4",{"data-count":"","children":[["$","span","0",{"className":"cite","children":["",[["$","span","jiang",{"children":["",["$","$L2",null,{"href":"/references/#jiang","children":"Jiang et al. (2025)"}]]}]],""]}]," blame intensive tillage combined with wind, water and freeze-thaw erosion. Summer storms run off long, gentle slopes, and land sloping 3 to 10 degrees makes up 46.39 per cent of the eroded area ",["$","span","2",{"className":"cite","children":["(",[["$","span","sui",{"children":["",["$","$L2",null,{"href":"/references/#sui","children":"Sui and Dai 2025"}]]}]],")"]}],". Runoff follows the furrows, cutting rills and then gullies, and in spring the wind strips the bare fields."]}]
24:["$","p","5",{"data-count":"","children":["Ploughing also lets air into the soil, so organic matter breaks down faster than roots and straw replace it, especially when straw is removed. In the top 5 centimetres, soil organic carbon has fallen from 44.7 to 23.9 grams per kilogram ",["$","span","1",{"className":"cite","children":["(",[["$","span","jiang",{"children":["",["$","$L2",null,{"href":"/references/#jiang","children":"Jiang et al. 2025"}]]}]],")"]}],", and soil with less organic matter erodes more easily."]}]
25:["$","p","6",{"data-count":"","children":["Heavy machinery also compacts the soil ",["$","span","1",{"className":"cite","children":["(",[["$","span","liao",{"children":["",["$","$L2",null,{"href":"/references/#liao","children":"Liao et al. 2026"}]]}]],")"]}],". After 80 years of cultivation, the bulk density of the top 30 centimetres has risen 59.49 per cent and water holding capacity has fallen 53.90 per cent ",["$","span","3",{"className":"cite","children":["(",[["$","span","sui",{"children":["",["$","$L2",null,{"href":"/references/#sui","children":"Sui and Dai 2025"}]]}]],")"]}],", so less rain soaks in and more runs off."]}]
26:["$","p","7",{"data-count":"","children":[["$","span","0",{"className":"cite","children":["",[["$","span","fao",{"children":["",["$","$L2",null,{"href":"/references/#fao","children":"FAO (2022)"}]]}]],""]}]," lists the same threats in all four black soil regions of the world, and ",["$","span","2",{"className":"cite","children":["",[["$","span","liao",{"children":["",["$","$L2",null,{"href":"/references/#liao","children":"Liao et al. (2026)"}]]}]],""]}]," describe comparable losses in Iowa and Ukraine, so the cause seems to be the farming system itself."]}]
