"href":"/references/#hlj25","children":"HPBS 2026"}]]}]],")"]}],". Farms on the Northeast Plain average 12.8 hectares per person, compared with 2.7 on the North China Plain ",["$","span","3",{"className":"cite","children":["(",[["$","span","huo",{"children":["",["$","$L2",null,{"href":"/references/#huo","children":"Huo et al. 2022"}]]}]],")"]}],", so a profit of about US$436 per hectare adds up."]}],["$","h2","2",{"data-count":"","children":"A shrinking, ageing population"}],["$","p","3",{"data-count":"","children":["Heilongjiang lost 330,000 people in 2024 ",["$","span","1",{"className":"cite","children":["(",[["$","span","caixin",{"children":["",["$","$L2",null,{"href":"/references/#caixin","children":"Caixin Global 2025"}]]}]],")"]}]," and 280,000 in 2025, and by my calculation its rural population fell by about 370,000 that year as urbanisation rose from 68.05 to 68.98 per cent ","$L6",". More than half the region’s primary schools have closed in a decade ","$L7",", giving young families less reason to stay."]}],"$L8","$L9","$La","$Lb"],"$undefined"]}],"$Lc"],["$Ld"],"$Le"]}],{},null,false,null]},null,false,"$f"]},null,false,null],"$L10",false]],"m":"$undefined","G":["$11",["$L12"]],"S":true,"h":null,"r":"$undefined","s":"$undefined","a":"$undefined","l":"$undefined","p":"$undefined","d":"$undefined","b":"crO8DC14Bc-sioLTCS85a"}
